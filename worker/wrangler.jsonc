{
  "name": "reader-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  // unpdf 依赖部分 Node 兼容 API，Workers 中解析 PDF 需要打开此开关。
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "EMBEDDING_MODEL": "@cf/baai/bge-base-en-v1.5",
    // bge-base-en-v1.5 输出 768 维，与现有 Vectorize 索引维度一致。
    "EMBEDDING_DIMENSIONS": "768"
  },
  "ai": {
    "binding": "AI",
    // 与 Vectorize 一样走远程绑定，本地 wrangler dev 调用真实 Workers AI。
    "remote": true
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "asset"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "rag-chunks",
      // Vectorize 目前没有本地模拟。本地 wrangler dev 通过 remote binding 写入真实索引。
      "remote": true
    }
  ]
}
